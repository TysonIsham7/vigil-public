# Copy to .env if you need optional integrations. Leave values empty to keep
# remote reputation lookups disabled. Never commit a filled-in .env.

# Licensed Google Safe Browsing key. Unused unless a provider is explicitly enabled.
VIGIL_SAFE_BROWSING_API_KEY=

# Optional PhishTank application key. Lookups stay off when this is empty.
VIGIL_PHISHTANK_API_KEY=

# Optional. When set, an improved prompt may be rewritten. Any failure falls
# back to the deterministic security appendix. Scans never require this.
XAI_API_KEY=
