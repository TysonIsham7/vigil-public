{
  "name": "vigil",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Vigil shared scan core, CLI, and browser extensions. Early. Not a store release.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "vigil": "node apps/cli/dist/vigil.js",
    "prepare": "git config core.hooksPath scripts/git-hooks || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.11",
    "eslint": "10.13.0",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "4.1.12"
  }
}
