{
  "manifest_version": 3,
  "name": "Vigil",
  "version": "2.0.0",
  "description": "Local-first site check. High Security Mode holds unknown sites before they load. Not a store release.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "webNavigation", "tabs", "declarativeNetRequest", "nativeMessaging", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["blank-relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vigil",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
